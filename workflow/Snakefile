import os
import yaml

container_registry = config.get("container_registry", "docker://registry.forgemia.inra.fr/asm4pg/genomasm4pg")
output_dir = os.path.join(config.get("output_dir_pdw", os.getcwd()), config.get("output_dir", "results/"))

rule all:
    input:
        # Required final assemblies and report
        expand(
            os.path.join(output_dir, "{sample}_results", "02_final_assembly", "hap{n}", "{sample}_final_hap{n}.fasta.gz"),
            sample=config["samples"].keys(), n=[1, 2]
        )
        ,
        expand(
            os.path.join(output_dir, "{sample}_results", "02_final_assembly", "hap{n}", "ragtag_scafold", "recap.txt"),
            sample=config["samples"].keys(), n=[1, 2]
        ),
        expand(
            os.path.join(output_dir, "{sample}_results", "{sample}_assembly_report.html"),
            sample=config["samples"].keys()
        ),
        directory(expand(
            os.path.join(output_dir, "{sample}_results", "04_assembly_qc", "quast"),
            sample=config["samples"].keys()
        ))

rule input_conversion:
    input: 
        lambda wildcards: config["samples"][wildcards.sample]["reads"]
    output:
        temp(os.path.join(output_dir, "{sample}_results", "00_converted_input","reads_{sample}_fasta.gz"))
    benchmark:
        os.path.join(output_dir, "{sample}_results", "benchmark", "input_conversion_benchmark.txt")
    threads: 20
    resources:
        mem_mb=250000,
        time="80:00:00"
    container:
        f"{container_registry}/samtools-pigz:latest"
    shell:
        """
        ./workflow/scripts/input_conversion.sh {input} {output} {threads}
        """
  
# Genome assembly using hifiasm
rule hifiasm:
    input:
        reads = rules.input_conversion.output
    output:
        hap1 = os.path.join(output_dir, "{sample}_results", "01_raw_assembly","raw_{sample}_hap1.gfa"),
        hap2 = os.path.join(output_dir, "{sample}_results", "01_raw_assembly","raw_{sample}_hap2.gfa")
    params:
        prefix = os.path.join(output_dir, "{sample}_results", "01_raw_assembly","{sample}"), 
        mode = get_mode, 
        run_1 = lambda wildcards: get_run(wildcards, run=1),
        run_2 = lambda wildcards: get_run(wildcards, run=2),
        purge_force = get_purge_force,
        raw_out_hap1 = os.path.join(output_dir, "{sample}_results", "01_raw_assembly","{sample}.bp.hap1.p_ctg.gfa"),
        raw_out_hap2 = os.path.join(output_dir, "{sample}_results", "01_raw_assembly","{sample}.bp.hap2.p_ctg.gfa")
    benchmark:
        os.path.join(output_dir, "{sample}_results", "benchmark", "hifiasm_benchmark.txt")
    threads: 20
    priority: 2
    resources:
        mem_mb=250000,
        time="80:00:00"
    container:
        f"{container_registry}/hifiasm-box:latest"
    shell:
        """
        ./workflow/scripts/hifiasm_call.sh {params.mode} {params.purge_force} {threads} {input.reads} {params.run_1} {params.run_2} {params.prefix} {output.hap1} {output.hap2}
        """

# Convert the GFA files of hifiasm to FASTA
TO_FA_CMD = r"""/^S/{print ">"$2;print $3}"""

rule pigz_gfa_to_fasta:
    input:
        gfa = os.path.join(output_dir, "{sample}_results", "01_raw_assembly", "raw_{sample}_hap{n}.gfa"),
    output:
        fasta = os.path.join(output_dir, "{sample}_results", "01_raw_assembly", "{sample}_hap{n}.fasta.gz")
    params:
        mode = get_mode,
        hic_scaffold = os.path.join(output_dir, "{sample}_results", "01_raw_assembly", "{sample}_hap{n}_scaffolds_final.fa")
    threads: 4
    resources:
        mem_mb=25000,
        time="80:00:00"
    benchmark:                                                                                                                  
        os.path.join(output_dir, "{sample}_results", "benchmark", "pigz_hap{n}_benchmark.txt")
    container:
        f"{container_registry}/samtools-pigz:latest"
    shell:
        """
        if [[ "{params.mode}" == "hi-c" ]]; then
            echo "Asm4pg -> Compressing the scafold"
            pigz -p {threads} -c {params.hic_scaffold} > {output.fasta}
        else
            awk {TO_FA_CMD:q} {input.gfa} | pigz -p {threads} > {output.fasta}
        fi
        """

# Potentialy purge the haplotigs using purge_dups
rule haplotigs_handling:
    input:
        hap_fasta = os.path.join(output_dir, "{sample}_results", "01_raw_assembly","{sample}_hap{n}.fasta.gz"),
        reads = rules.input_conversion.output
    output:
        hap = os.path.join(output_dir, "{sample}_results", "02_final_assembly","hap{n}","{sample}_final_hap{n}.fasta.gz"),
        cutoffs = os.path.join(output_dir, "{sample}_results", "02_final_assembly","hap{n}","cutoffs")
    params:
        prefix = "{sample}_hap{n}",
        out_dir = os.path.join(output_dir, "{sample}_results", "02_final_assembly", "hap{n}"),
        purge_dups_option = get_purge_bool
    threads: 20
    benchmark:                                                                                                                  os.path.join(output_dir, "{sample}_results", "benchmark", "haplotigs_handling_hap{n}_benchmark.txt")
    resources:
        mem_mb=100000,
        time="80:00:00"
    container:
        f"{container_registry}/purge_dups1.2.5"
    shell:
        """
        ./workflow/scripts/haplotigs_handling.sh {params.purge_dups_option} {input.hap_fasta} {output.hap} {params.prefix} {input.reads} {params.out_dir}
        """

# Rule to unsip the haplotypes if needed for other rules
rule unpigz_to_fasta:
    input:
        rules.haplotigs_handling.output.hap
    output:
        temp(os.path.join(output_dir, "{sample}_results", "02_final_assembly","hap{n}","{sample}_final_hap{n}.fasta"))
    container:
        f"{container_registry}/samtools-pigz:latest"
    threads: 4
    benchmark:                                                                                                                  os.path.join(output_dir, "{sample}_results", "benchmark", "unpigz_hap{n}_benchmark.txt")
    resources:
        mem_mb=25000,
        time="80:00:00"
    shell:
        "unpigz -k -p 1 {input}"


