include: "rules/genomescope.smk"
## ASSEMBLY
if config["mode"] == "trio":
    include: "rules/hifiasm_trio.smk"
elif config["mode"] == "hi-c":
    include: "rules/hifiasm_hic.smk"
else:
    include: "rules/hifiasm.smk"
include: "rules/hap_gfa_to_fasta.smk"
# Statistics
include: "rules/genometools_on_assembly.smk"
include: "rules/unzip_hap_fasta.smk"
include: "rules/busco.smk"
include: "rules/kat.smk"
include: "rules/meryl.smk"
include: "rules/merqury.smk"
include: "modules/merqury_trio.smk"
# Purging
include: "rules/purge_dups.smk"
