# Count k-mers in the input reads and generate a histogram of k-mer frequencies.
rule jellyfish:
    input:
        reads = rules.input_conversion.output.fastagz
    output:
        jf = temp(os.path.join(output_dir, "{sample}_results", "03_raw_data_qc", "jellyfish", "{sample}.jf")),
        histo = os.path.join(output_dir, "{sample}_results", "03_raw_data_qc", "jellyfish", "{sample}.histo")
    params:
        km_size = get_kmer_size
    threads: 10
    benchmark:
        os.path.join(output_dir, "{sample}_results", "benchmark", "jellyfish_benchmark.txt")
    log:
        os.path.join(output_dir, "{sample}_results", "logs", "jellyfish.log")
    resources:
        mem_mb=80000,
    container:
        f"{container_registry}/jellyfish2.3.0"
    shell:
        """
        echo "🔹 Asm4pg -> starting jellyfish counts of kmers of size {params.km_size}" >> {log} 2>&1
        jellyfish count -m {params.km_size} -s 100M -t {threads} -o {output.jf} -C <(zcat {input.reads}) >> {log} 2>&1
        echo "🔹 Asm4pg -> starting to compute jellyfish histogram" >> {log} 2>&1
        jellyfish histo -h 1000000 -t {threads} {output.jf} > {output.histo} 2>> {log}
        if [ ! -s {output.histo} ]; then
            echo "⚠️  Asm4pg -> jellyfish missing histo, check logs" >> {log}
        else
            echo "✅ Asm4pg -> jellyfish histo created" >> {log}
        fi
        """

# Analyze the k-mer histogram and estimate genome characteristics, including genome size, heterozygosity, and error rates. 
rule genomescope:
    input:
        rules.jellyfish.output.histo
    output:
        plot = os.path.join(output_dir, "{sample}_results", "03_raw_data_qc", "genomescope", "linear_plot.png"),
        summary = os.path.join(output_dir, "{sample}_results", "03_raw_data_qc", "genomescope", "summary.txt")
    params:
        ploidy = get_ploidy,
        km_size = get_kmer_size,
        out_dir = os.path.join(output_dir, "{sample}_results", "03_raw_data_qc", "genomescope"),
    benchmark:
        os.path.join(output_dir, "{sample}_results", "benchmark", "genomescope_benchmark.txt")
    log:
        os.path.join(output_dir, "{sample}_results", "logs", "genomescope.log")
    container:
        f"{container_registry}/genomescope2.0"
    shell:
        "genomescope.R -k {params.km_size} -i {input} -o {params.out_dir} -p {params.ploidy} > {log} 2>&1 "

# Compare the k-mer content between the assembly and the raw reads.
rule kat:
    input:
        hap = rules.haplotigs_handling.output.hap,
        jellyfish = rules.jellyfish.output.jf
    output:
        os.path.join(output_dir, "{sample}_results", "04_assembly_qc", "hap{n}", "katplot", "{sample}_hap{n}.katplot.png")
    params:
        out_dir = os.path.join(output_dir, "{sample}_results", "04_assembly_qc", "hap{n}", "katplot", "{sample}_hap{n}"),
        km_size = get_kmer_size
    threads: 4
    benchmark:
        os.path.join(output_dir, "{sample}_results", "benchmark", "kat_hap{n}_benchmark.txt")
    log:
        os.path.join(output_dir, "{sample}_results", "logs", "kat_hap{n}.log")
    resources:
        mem_mb=100000,
    container: 
        f"{container_registry}/kat2.4.1"
    shell:
        """
        echo "🔹 Asm4pg -> starting kat comp" > {log} 2>&1
        kat comp -o {params.out_dir} -t {threads} -m {params.km_size} --output_type png -v {input.jellyfish} {input.hap} >> {log} 2>&1
        echo "🔹 Asm4pg -> starting kat plot" > {log} 2>&1
        kat plot spectra-cn -x 200 -o {params.out_dir}.katplot.png {params.out_dir}-main.mx >> {log} 2>&1 
        if [ ! -s {output} ]; then
            echo "⚠️  Asm4pg -> plot missing, check logs" >> {log}
        else
            echo "✅ Asm4pg -> plot created" >> {log}
        fi
        """

# Creates a k-mer database from the input reads 
rule meryl:
    input:
        rules.input_conversion.output.fastagz
    output:
        db = directory(os.path.join(output_dir, "{sample}_results", "04_assembly_qc", "merqury", "{sample}_reads-db.meryl"))
    params:
        km_size = get_kmer_size,
        mode = get_mode,
        r1 = lambda wildcards: get_run(wildcards, run=1),
        r2 = lambda wildcards: get_run(wildcards, run=2),
        out_dir = os.path.join(output_dir, "{sample}_results", "04_assembly_qc", "merqury")
    threads: 20
    benchmark:
        os.path.join(output_dir, "{sample}_results", "benchmark", "meryl_benchmark.txt")
    log:
        os.path.join(output_dir, "{sample}_results", "logs", "meryl.log")
    resources:
        mem_mb=120000, 
    container:
        f"{container_registry}/merqury1.3"
    shell:
        """
        echo "🔹 Asm4pg -> starting meryl" > {log} 2>&1
        if [[ "{params.mode}" == "trio" ]]; then
            echo "🔹 Asm4pg -> trio mode detected" >> {log} 2>&1
            echo "🔹 Asm4pg -> counting p1" >> {log} 2>&1
            meryl k={params.km_size} threads={threads} count {params.r1} output {params.out_dir}/{wildcards.sample}_P1-db.meryl >> {log} 2>&1
            echo "🔹 Asm4pg -> counting p2" >> {log} 2>&1
            meryl k={params.km_size} threads={threads} count {params.r2} output {params.out_dir}/{wildcards.sample}_P2-db.meryl >> {log} 2>&1
        fi
        echo "🔹 Asm4pg -> counting input reads" >> {log} 2>&1
        meryl k={params.km_size} threads={threads} count {input} output {output.db} >> {log} 2>&1
        """

rule merqury:
    input:
        km_database = rules.meryl.output,
        hap1 = os.path.join(output_dir, "{sample}_results", "02_final_assembly","hap1","{sample}_final_hap1.fasta"),
        hap2 = os.path.join(output_dir, "{sample}_results", "02_final_assembly","hap2","{sample}_final_hap2.fasta"),
    output:
        qv = os.path.join(output_dir, "{sample}_results", "04_assembly_qc", "merqury", "{sample}_merqury.qv"),
        stats = os.path.join(output_dir, "{sample}_results", "04_assembly_qc", "merqury", "{sample}_merqury.completeness.stats")
    params:
        prefix = "{sample}_merqury",
        out_dir = os.path.join(output_dir, "{sample}_results", "04_assembly_qc", "merqury"),
        mode = get_mode
    threads: 20
    benchmark:
        os.path.join(output_dir, "{sample}_results", "benchmark", "merqury_benchmark.txt")
    log:
        os.path.join(output_dir, "{sample}_results", "logs", "merqury.log")
    resources:
        mem_mb=120000, 
    container:
        f"{container_registry}/merqury1.3"
    shell:
        """
        echo "🔹 Asm4pg -> Starting merqury" > {log} 2>&1
        cp {input.hap1} {params.out_dir}/{wildcards.sample}_hap1.fasta >> {log} 2>&1
        cp {input.hap2} {params.out_dir}/{wildcards.sample}_hap2.fasta >> {log} 2>&1
        cd {params.out_dir} >> {log} 2>&1
        export MERQURY=/usr/local/share/merqury
        if [[ "{params.mode}" == "trio" ]]; then
            echo "🔹 Asm4pg -> trio mode detected" >> {log} 2>&1
            echo "🔹 Asm4pg -> creating hapmer" >> {log} 2>&1
            $MERQURY/trio/hapmers.sh {wildcards.sample}_P1-db.meryl {wildcards.sample}_P2-db.meryl {input.km_database} >> {log} 2>&1
            echo "🔹 Asm4pg -> running merqury" >> {log} 2>&1
            merqury.sh {input.km_database} {wildcards.sample}_P1-db.hapmer.meryl {wildcards.sample}_P2-db.hapmer.meryl {wildcards.sample}_hap1.fasta {wildcards.sample}_hap2.fasta {params.prefix} >> {log} 2>&1
            rm *.fai >> {log} 2>&1
            rm *.txt >> {log} 2>&1
            rm *.gaps >> {log} 2>&1
            rm *.count* >> {log} 2>&1
            rm *block.sizes >> {log} 2>&1
            rm *contig.sizes* >> {log} 2>&1
            rm *block.stats* >> {log} 2>&1
            rm *hap1*.png >> {log} 2>&1
            rm *hap2*.png >> {log} 2>&1
        else
            echo "🔹 Asm4pg -> default mode detected" >> {log} 2>&1
            merqury.sh {input.km_database} {wildcards.sample}_hap1.fasta {wildcards.sample}_hap2.fasta {params.prefix} >> {log} 2>&1
            rm *hap*.png >> {log} 2>&1
        fi
        echo "🔹 Asm4pg -> cleaning up" >> {log} 2>&1
        rm *.bed >> {log} 2>&1
        rm *.wig >> {log} 2>&1
        rm *.fasta >> {log} 2>&1
        rm *.hist >> {log} 2>&1
        rm *.filt >> {log} 2>&1
        rm *.ploidy >> {log} 2>&1
        rm *hap*.qv >> {log} 2>&1
        rm -rf logs >> {log} 2>&1
        echo "🔹 Asm4pg -> Done!" >> {log} 2>&1
        """

# Identifies LTR retrotransposons
rule LTR_finder:
    input:
        rules.unpigz_to_fasta.output
    output:
        os.path.join(output_dir, "{sample}_results", "04_assembly_qc", "hap{n}", "LTR", "{sample}_hap{n}.scn")
    resources:
        mem_mb=60000, 
    benchmark:
        os.path.join(output_dir, "{sample}_results", "benchmark", "ltr_finder_hap{n}_benchmark.txt")
    log:
        os.path.join(output_dir, "{sample}_results", "logs", "LTR_finder_hap{n}.log")
    container:
        f"{container_registry}/ltr_finder:latest"
    shell:
        """
        echo "🔹 Asm4pg -> Starting LTR finder" > {log} 2>&1
        ltr_finder -C {input} > {output} 2>> {log} 2>&1
        if [ ! -s {output} ]; then
            echo "⚠️  Asm4pg -> scn missing, check logs" >> {log}
        else
            echo "✅ Asm4pg -> snc created" >> {log}
        fi
        """

# Calculates the LTR Assembly Index (LAI), a metric for assembly quality based on LTR retrotransposons
rule LTR_retriever:
    input:
        scn = rules.LTR_finder.output,
        hap = rules.unpigz_to_fasta.output
    output:
        lai = os.path.join(output_dir, "{sample}_results", "04_assembly_qc", "hap{n}", "LTR", "{sample}_hap{n}.out.LAI"),
        recap =  os.path.join(output_dir, "{sample}_results", "04_assembly_qc", "hap{n}", "LTR", "recap_{sample}_hap{n}.tbl")
    params:
        prefix="{sample}_hap{n}",
        scn="{sample}_hap{n}.scn",
        out_dir = os.path.join(output_dir, "{sample}_results", "04_assembly_qc", "hap{n}", "LTR")
    threads: 20
    resources:
        mem_mb=250000
    benchmark:
        os.path.join(output_dir, "{sample}_results", "benchmark", "ltr_retriever_hap{n}_benchmark.txt")
    log:
        os.path.join(output_dir, "{sample}_results", "logs", "LTR_retriever_hap{n}.log")
    container:
        f"{container_registry}/ltr_retriever:3.0.1"
    shell:
        '''
        export PATH="/opt/LTR_retriever:$PATH"
        cp {input.hap} {params.out_dir}/tmp_hap.fasta > {log} 2>&1
        cd {params.out_dir} >> {log} 2>&1
        LTR_retriever -threads {threads} -genome tmp_hap.fasta -infinder {params.scn} >> {log} 2>&1
        
        # Check if LAI file was created, if not create a placeholder
        if [ -f tmp_hap.fasta.out.LAI ]; then
            mv tmp_hap.fasta.out.LAI {params.prefix}.out.LAI >> {log} 2>&1
        else
            echo "Impossible to calculate LAI score for this assembly" > {params.prefix}.out.LAI
            echo "🔹 Asm4pg -> LAI file not generated, created placeholder" >> {log} 2>&1
        fi
        
        mv tmp_hap.fasta.tbl recap_{params.prefix}.tbl >> {log} 2>&1
        echo "🔹 Asm4pg -> Cleaning LTR_retriever tmp output files" >> {log} 2>&1
        rm tmp* >> {log} 2>&1
        echo "✅ Asm4pg -> done!" >> {log} 2>&1
        '''

# Rule to create scafold on assemblies
rule scafolding:
    input:
        os.path.join(output_dir, "{sample}_results", "02_final_assembly", "hap{n}", "{sample}_final_hap{n}.fasta")
    output:
        os.path.join(output_dir, "{sample}_results", "02_final_assembly", "hap{n}", "ragtag_scafold", "recap.txt")
    params:
        out_file = os.path.join(output_dir, "{sample}_results", "02_final_assembly", "hap{n}", "ragtag_scafold", "{sample}_scafold_hap{n}.fasta.gz"),
        out_dir = os.path.join(output_dir, "{sample}_results", "02_final_assembly", "hap{n}", "ragtag_scafold"),
        reference_genome = get_reference,
        ragtag_bool = get_ragtag_bool
    threads: 4
    resources:
        mem_mb = 80000,
    benchmark:
        os.path.join(output_dir, "{sample}_results", "benchmark", "scafolding_hap{n}_benchmark.txt")
    log:
        os.path.join(output_dir, "{sample}_results", "logs", "scafolding_hap{n}.log")
    container:
        f"{container_registry}/ragtag:2.0.1"
    shell:
        """
        ./workflow/scripts/ragtag_call.sh \
            {params.ragtag_bool} \
            {params.out_dir} \
            {threads} \
            {params.reference_genome} \
            {input} \
            {params.out_file} \
            {output} > {log} 2>&1 
        """

# Rule to create a quast report assessing the quality of all assemblies
rule quast:
    input:
        raw_hap1 = os.path.join(output_dir, "{sample}_results", "01_raw_assembly", "{sample}_hap1.fasta.gz"),
        raw_hap2 = os.path.join(output_dir, "{sample}_results", "01_raw_assembly", "{sample}_hap2.fasta.gz"),
        final_hap1 = os.path.join(output_dir, "{sample}_results", "02_final_assembly", "hap1", "{sample}_final_hap1.fasta.gz"),
        final_hap2 = os.path.join(output_dir, "{sample}_results", "02_final_assembly", "hap2", "{sample}_final_hap2.fasta.gz"),
    output:
        directory(os.path.join(output_dir, "{sample}_results", "04_assembly_qc", "quast"))
    params:
        quast_bool=get_quast_bool,
        reference_genome=get_reference,
        purge_bool=get_purge_bool,
        quast_output = os.path.join(output_dir, "{sample}_results", "04_assembly_qc", "quast")
    container:
        f"{container_registry}/staphb/quast:5.2.0"
    threads: 20
    benchmark:
        os.path.join(output_dir, "{sample}_results", "benchmark", "quast_benchmark.txt")
    resources:
        mem_mb=250000
    log:
        os.path.join(output_dir, "{sample}_results", "logs", "quast_call.log")
    shell:
        """
        echo "🔹 Asm4pg -> Checking QUAST status" > {log} 2>&1 
        if [[ "{params.quast_bool}" == "True" ]]; then
            echo "🔹 Asm4pg -> Starting QUAST" > {log} 2>&1 
            ./workflow/scripts/quast_call.sh {params.reference_genome} {params.purge_bool} {input.raw_hap1} {input.raw_hap2} {input.final_hap1} {input.final_hap2} {params.quast_output} >> {log} 2>&1 
        else
            mkdir -p {params.quast_output}
            echo "🔹 Asm4pg -> Quast turned off" > {params.quast_output}/quast.txt 2>> {log} 2>&1 
        fi
        echo "✅ Asm4pg -> done!" >> {log} 2>&1
        """

# Rule to generate the html report
rule generate_report:
    input:
        genomescope = os.path.join(output_dir, "{sample}_results", "03_raw_data_qc", "genomescope", "linear_plot.png"),
        genomescope_sum = os.path.join(output_dir, "{sample}_results", "03_raw_data_qc", "genomescope", "summary.txt"),
        genometools_on_raw_data = os.path.join(output_dir, "{sample}_results", "03_raw_data_qc", "{sample}_genometools_stats.txt"),

        genometools_hap1 = os.path.join(output_dir, "{sample}_results", "04_assembly_qc", "hap1", "{sample}_hap1_genometools_stats.txt"),
        genometools_hap2 = os.path.join(output_dir, "{sample}_results", "04_assembly_qc", "hap2", "{sample}_hap2_genometools_stats.txt"),
        
        busco_hap1 = os.path.join(output_dir, "{sample}_results", "04_assembly_qc", "hap1", "busco", "busco_{sample}_hap1.txt"),
        busco_hap2 = os.path.join(output_dir, "{sample}_results", "04_assembly_qc", "hap2", "busco", "busco_{sample}_hap2.txt"),

        kplot_hap1 =os.path.join(output_dir, "{sample}_results", "04_assembly_qc", "hap1", "katplot", "{sample}_hap1.katplot.png"),
        kplot_hap2 =os.path.join(output_dir, "{sample}_results", "04_assembly_qc", "hap2", "katplot", "{sample}_hap2.katplot.png"),

        telomeres_hap1 = os.path.join(output_dir, "{sample}_results", "04_assembly_qc", "hap1", "telomeres", "{sample}_hap1_telomeres.txt"),
        telomeres_hap2 = os.path.join(output_dir, "{sample}_results", "04_assembly_qc", "hap2", "telomeres", "{sample}_hap2_telomeres.txt"),
        
        LAI_hap1 = os.path.join(output_dir, "{sample}_results", "04_assembly_qc", "hap1", "LTR", "{sample}_hap1.out.LAI"),
        LAI_hap2 = os.path.join(output_dir, "{sample}_results", "04_assembly_qc", "hap2", "LTR", "{sample}_hap2.out.LAI"),
        
        LRT_recap_hap1 = os.path.join(output_dir, "{sample}_results", "04_assembly_qc", "hap1", "LTR", "recap_{sample}_hap1.tbl"),
        LRT_recap_hap2 = os.path.join(output_dir, "{sample}_results", "04_assembly_qc", "hap2", "LTR", "recap_{sample}_hap2.tbl"),

        merqury_stats=os.path.join(output_dir, "{sample}_results", "04_assembly_qc", "merqury", "{sample}_merqury.completeness.stats"),
        merqury_qv=os.path.join(output_dir, "{sample}_results", "04_assembly_qc", "merqury", "{sample}_merqury.qv")
    output:
        os.path.join(output_dir, "{sample}_results", "{sample}_assembly_report.html")
    params:
        sample = "{sample}",
        mode = get_mode,
        assembly_purge_force = get_purge_force,
        purge_dups_bool = get_purge_bool,
        busco_lineage = get_busco_lin,
        ploidy = get_ploidy,
        kmer_size = get_kmer_size,
        ragtag_bool = get_ragtag_bool,
        r1 = lambda wildcards: get_run(wildcards, run=1),
        r2 = lambda wildcards: get_run(wildcards, run=2)
    benchmark:
        os.path.join(output_dir, "{sample}_results", "benchmark", "generate_report_benchmark.txt")
    container:
        f"{container_registry}/rmarkdown4.0.3"
    script:
        "./scripts/report.Rmd"

onsuccess:
    print("✅ Asm4pg -> Workflow completed successfully")
    shell("date")

onerror: 
    print("❌ Asm4pg -> Workflow failed, check logs")
    shell("date")